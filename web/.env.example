# =============================================================
# Fio — canal web (interface Next.js)
# Copie para .env.local em desenvolvimento. No compose, essas vars
# chegam via env_file (.env da raiz) + environment do servico web.
# =============================================================

# Segredo da sessao (next-auth convidado). Gere com: openssl rand -base64 32
AUTH_SECRET=CHANGE_ME

# Conexao do Postgres no database fio_web (historico das conversas do chat).
# No compose: postgres://fio:SENHA_DO_POSTGRES@db:5432/fio_web
POSTGRES_URL=postgres://fio:CHANGE_ME@localhost:5432/fio_web

# URL do server Express (o cerebro do Fio — SPEC 9.1).
# Dentro do compose: http://server:3000
FIO_SERVER_URL=http://localhost:3000

# Token do header x-webhook-token — TEM que ser o mesmo WEBHOOK_TOKEN do server.
FIO_WEBHOOK_TOKEN=CHANGE_ME
