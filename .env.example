# =============================================================
# Fio (snsvisao) — variaveis de ambiente
# Copie para .env e preencha os CHANGE_ME (o scripts/setup-vps.sh
# faz isso automaticamente com valores aleatorios seguros).
# =============================================================

# ---- Postgres (servico db do compose) ----
# Senha do usuario fio do Postgres. Usada no db e montada na DATABASE_URL.
POSTGRES_PASSWORD=CHANGE_ME

# ---- Server (API Express) ----
# Porta HTTP do server (publicada em 3000:3000 no compose).
PORT=3000
# URL de conexao do Postgres do app. Formato fixo; a senha deve ser
# a mesma de POSTGRES_PASSWORD (o setup-vps.sh ja sincroniza).
DATABASE_URL=postgres://fio:CHANGE_ME@db:5432/fio
# Token que a Evolution API envia no header x-webhook-token ao chamar
# o webhook do server. Qualquer string longa e secreta serve.
WEBHOOK_TOKEN=CHANGE_ME
# Token de administracao (header x-admin-token) para rotas /admin/*,
# incluindo /admin/qrcode usado no fluxo de conexao do WhatsApp.
ADMIN_TOKEN=CHANGE_ME
# Slug do tenant unico desta fase (multi-tenant fica para o roadmap).
DEFAULT_TENANT_SLUG=default

# ---- LLM (provedor plugavel) ----
# Provedor de IA: anthropic | kimi | openai
LLM_PROVIDER=anthropic
# Modelo. Livre; se vazio, o factory usa o default do provider
# (anthropic: claude-opus-4-5, kimi: kimi-k2, openai: gpt-4o).
LLM_MODEL=claude-opus-4-5
# Chave de API do provedor de LLM escolhido.
LLM_API_KEY=CHANGE_ME
# Opcional: sobrescreve a URL base da API do LLM
# (kimi default https://api.moonshot.cn/v1).
LLM_BASE_URL=

# ---- Evolution API (WhatsApp) ----
# URL interna da Evolution API (nao exposta fora da rede do compose).
EVOLUTION_API_URL=http://evolution:8080
# Chave mestra da Evolution API (AUTHENTICATION_API_KEY). Tambem usada
# pelos scripts em scripts/lib-evolution.sh. Gere uma longa e secreta.
EVOLUTION_API_KEY=CHANGE_ME
# Nome da instancia do WhatsApp dentro da Evolution API.
EVOLUTION_INSTANCE=fio

# ---- Throttle anti-spam ----
# Intervalo minimo (ms) entre envios de mensagem ao mesmo contato.
SEND_MIN_INTERVAL_MS=1200
