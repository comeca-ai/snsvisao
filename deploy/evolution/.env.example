# Copiar para .env nesta pasta (nunca commitar o .env preenchido)

# Chave de acesso à API do Evolution — gerar algo longo e aleatório:
#   openssl rand -hex 32
AUTHENTICATION_API_KEY=

# Senha do Postgres local da stack
POSTGRES_PASSWORD=

# URL pública desta máquina (IP ou domínio). Ex.: http://SEU_IP:8080
SERVER_URL=
